# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Herramientas de especificación (npm; la API usa uv)
node_modules/

# Frontend Angular (frontend/, npm)
frontend/.angular/
frontend/dist/

# Tests, lint y cobertura
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Entorno y secretos (`.env.example` sí se commitea)
.env
.env.*
!.env.example

# Logs (AGENTS.md #7: la salida va a logs/)
logs/*
!logs/.gitkeep
*.log
*.log.*

# Base de datos local
db.sqlite3
*.mysql

# Sistema / editor
.DS_Store
.idea/
.vscode/

# Tooling local de agentes (ZCode): skills y planes, por desarrollador
.agents/
.zcode/
.zcodeignore
skills-lock.json
# Integraciones OpenSpec generadas por persona; los comandos propios sí se versionan
.opencode/skills/openspec-*/
.opencode/commands/opsx-*.md

# Documentación original del cliente en trabajo (se consolida en docs/)
tmp_docs/

# Estado efímero de los scripts de bootstrap
scripts/.project-number
scripts/.milestone-map
scripts/.backlog.*
