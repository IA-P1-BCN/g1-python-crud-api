# `task env` prepara `.env` solo: copia esta plantilla si falta, rellena
# SECRET_KEY y ADMIN_PASSWORD y elige un puerto MySQL libre si 3306 está
# ocupado (fija MYSQL_PORT; Compose lee el mismo valor).
# Ajusta a mano lo que quieras: el bootstrap nunca pisa valores ya puestos.
# SECRET_KEY es obligatoria para JWT (al menos 32 caracteres aleatorios).
# ADMIN_PASSWORD es obligatoria para task seed (12–128 caracteres).
# Sustituye el marcador en `.env`, que no se sube a Git.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_DATABASE=gym_db
# TLS para MySQL gestionados que lo exigen (p. ej. Aiven); local, false.
MYSQL_SSL=false
# CA del servidor (contenido PEM o ruta a ca.pem). Aiven la exige; local, vacío.
MYSQL_SSL_CA=

# Orígenes CORS del frontend, separados por comas (vacío = sin CORS).
# Ejemplo en Render: ALLOWED_ORIGINS=https://g1-frontend.onrender.com
ALLOWED_ORIGINS=

ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
# Genera una clave propia: uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# JWT: minutos de validez (entero de 1 a 1440); reinicia la API al cambiarlo.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Logging (ver core/logging.py): nivel y fichero de salida
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
