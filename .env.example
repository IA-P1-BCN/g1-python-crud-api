# Copia este archivo a `.env` y ajusta los valores si hace falta:
#   cp .env.example .env
# Los valores por defecto coinciden con docker-compose.yml.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_DATABASE=gym_db

# Genera una clave aleatoria con `task env` o `uv run python -m scripts.ensure_env`.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
