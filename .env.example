# Copia este archivo a `.env` y ajusta los valores si hace falta:
#   cp .env.example .env
# Los valores por defecto coinciden con docker-compose.yml.
# Si 3306 está ocupado, usa MYSQL_PORT=3307; Compose lee el mismo valor.
# V1 (GymFlow) utiliza solo MySQL: no necesita SECRET_KEY ni variables JWT.
# ADMIN_PASSWORD está declarada pero aún no la usa ningún endpoint. El valor
# de abajo es un marcador: pon el tuyo en `.env`, que no se sube a Git.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_DATABASE=gym_db

ADMIN_PASSWORD=change-me
# Logging (ver core/logging.py): nivel y fichero de salida
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
